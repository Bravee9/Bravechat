{
  "name": "@discord-clone/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify REST API & WebSocket server for Discord Clone",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "r2:test": "tsx scripts/r2-smoke-test.ts",
    "r2:cors": "tsx scripts/r2-cors.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.1",
    "@fastify/jwt": "10.2.7",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/websocket": "11.3.7",
    "@prisma/client": "^5.15.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "fastify": "5.12.8",
    "ioredis": "^5.4.1",
    "livekit-server-sdk": "^2.9.6",
    "pino": "^9.3.1",
    "pino-pretty": "^11.2.1",
    "socket.io": "^4.7.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^7.14.0",
    "@typescript-eslint/parser": "^7.14.0",
    "eslint": "^8.57.0",
    "fastify-plugin": "^6.0.1",
    "prisma": "^5.15.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0"
  }
}

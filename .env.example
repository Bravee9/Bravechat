# Environment Variables Reference
# ─────────────────────────────────────────────────────
# Copy file này thành .env và điền các giá trị thực
# KHÔNG commit file .env lên Git!
# ─────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════
# FRONTEND (apps/web) — prefix NEXT_PUBLIC_ cho client-side
# ═══════════════════════════════════════════════════

# URL của API server (Fastify)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# URL WebSocket realtime của API server
NEXT_PUBLIC_WS_URL=ws://localhost:4000/api/ws

# Tắt mock data khi kết nối backend thật
NEXT_PUBLIC_USE_MOCKS=false

# URL công khai của Frontend (dùng cho SEO metadata / OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL công khai để truy cập file từ Cloudflare R2
# (Dùng R2 custom domain hoặc r2.dev subdomain)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ═══════════════════════════════════════════════════
# BACKEND (apps/api) — server-only, không bao giờ public
# ═══════════════════════════════════════════════════

# Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ─── Database ──────────────────────────────────────
# PostgreSQL connection string & Docker Compose credentials
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
POSTGRES_DB=discord_db
POSTGRES_USER=discord_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql://discord_user:CHANGE_ME_STRONG_POSTGRES_PASSWORD@localhost:5432/discord_db

# ─── Redis ─────────────────────────────────────────
# Redis connection string & Docker Compose credentials
# Format: redis://:PASSWORD@HOST:PORT
REDIS_ENABLED=true
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@localhost:6379

# ─── Optional Dev Storage / Admin Tools (Docker profiles) ───
MINIO_ROOT_USER=CHANGE_ME_MINIO_ADMIN_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
PGADMIN_DEFAULT_EMAIL=admin@bravechat.dev
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PGADMIN_PASSWORD

# ─── JWT Authentication ─────────────────────────────
# Secret key — phải là string ngẫu nhiên dài ít nhất 32 ký tự
# Generate: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_USE_RANDOM_32_CHAR_STRING_HERE
JWT_EXPIRES_IN=7d

# ─── Cloudflare R2 Storage ──────────────────────────
# Lấy từ Cloudflare Dashboard > R2 > Manage API tokens
R2_BUCKET_NAME=discord-clone-assets
R2_ENDPOINT_URL=https://d18481e864512aa8dc03e59c3d1c6825.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# URL công khai nếu bucket có custom domain hoặc r2.dev enabled
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ─── App Settings ───────────────────────────────────
# URL của frontend (dùng cho CORS & CSRF Origin check)
FRONTEND_URL=http://localhost:3000

# Danh sách origin bổ sung được phép (phân tách bằng dấu phẩy, tùy chọn)
# CORS_ORIGINS=https://bravechat-git-dev.vercel.app

# URL công khai của API (dùng dựng link /api/media/* và tự động nhận diện cookie cross-site)
API_PUBLIC_URL=http://localhost:4000

# Chính sách cookie phiên đăng nhập: auto | lax | none | strict
# auto: tự bật SameSite=None; Secure khi FRONTEND_URL và API_PUBLIC_URL khác domain HTTPS (ví dụ Vercel + Render)
COOKIE_SAME_SITE=auto

# Tùy chọn domain dùng chung cho cookie khi gắn custom domain (ví dụ .bravechat.app)
# COOKIE_DOMAIN=

# Tin cậy header X-Forwarded-For từ reverse proxy (mặc định true khi NODE_ENV=production)
# TRUST_PROXY=true

# Max file upload size (bytes) — default 50MB
MAX_FILE_SIZE=52428800

# ─── LiveKit SFU (local Docker development) ──────────────────
# These development credentials must match livekit.yaml. Replace them
# together with a secure config and TLS/TURN setup in production.
LIVEKIT_URL=ws://localhost:7880
# API-to-LiveKit HTTP endpoint (use http://livekit:7880 inside Docker).
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_TOKEN_TTL_SECONDS=300

# Password reset & Login OTP email delivery (Gmail HTTPS Webhook, Resend, or Gmail SMTP)
# 1) Trên Render Free (cổng SMTP 465 bị chặn), dùng GMAIL_WEBHOOK_URL (Google Apps Script HTTPS) hoặc RESEND_API_KEY:
# GMAIL_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESET_EMAIL_FROM=Bravechat <noreply@your-verified-domain.example>
# 2) Trên Local / VPS / Docker (mở cổng 465), có thể gửi trực tiếp qua Gmail SMTP:
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Environment Variables Reference
# ─────────────────────────────────────────────────────
# Copy file này thành .env và điền các giá trị thực
# KHÔNG commit file .env lên Git!
# ─────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════
# FRONTEND (apps/web) — prefix NEXT_PUBLIC_ cho client-side
# ═══════════════════════════════════════════════════

# URL của API server (Fastify)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# URL công khai để truy cập file từ Cloudflare R2
# (Dùng R2 custom domain hoặc r2.dev subdomain)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ═══════════════════════════════════════════════════
# BACKEND (apps/api) — server-only, không bao giờ public
# ═══════════════════════════════════════════════════

# Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ─── Database ──────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://discord_user:discord_secret_2024@localhost:5432/discord_db

# ─── Redis ─────────────────────────────────────────
# Redis connection string
# Format: redis://:PASSWORD@HOST:PORT
REDIS_URL=redis://:redis_secret_2024@localhost:6379

# ─── JWT Authentication ─────────────────────────────
# Secret key — phải là string ngẫu nhiên dài ít nhất 32 ký tự
# Generate: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_USE_RANDOM_32_CHAR_STRING_HERE
JWT_EXPIRES_IN=7d

# ─── Cloudflare R2 Storage ──────────────────────────
# Lấy từ Cloudflare Dashboard > R2 > Manage API tokens
R2_BUCKET_NAME=discord-clone-assets
R2_ENDPOINT_URL=https://d18481e864512aa8dc03e59c3d1c6825.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# URL công khai nếu bucket có custom domain hoặc r2.dev enabled
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ─── App Settings ───────────────────────────────────
# URL của frontend (dùng cho CORS)
FRONTEND_URL=http://localhost:3000

# Max file upload size (bytes) — default 50MB
MAX_FILE_SIZE=52428800

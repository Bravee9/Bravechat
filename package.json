{
  "name": "discord-clone",
  "version": "0.1.0",
  "private": true,
  "description": "A real-time communication platform clone built by Bravee9",
  "author": "Bravee9",
  "license": "MIT",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "db:prepare": "node scripts/db.mjs",
    "db:local": "powershell -NoProfile -File scripts/local-db.ps1",
    "test:integration": "node scripts/test-workflows.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prisma": "^5.22.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
